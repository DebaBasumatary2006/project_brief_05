{
  "info": {
    "name": "Inventory Management System - Sprint 15 Product API",
    "description": "MongoDB-backed product CRUD lifecycle. Set baseUrl and run requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    {
      "name": "List products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Products are listed', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Create product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product is created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('productId', pm.response.json().data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productName\": \"Canvas Tote\",\n  \"sku\": \"BAG-{{$timestamp}}\",\n  \"category\": \"Accessories\",\n  \"supplier\": \"Local Supplier\",\n  \"purchasePrice\": 8,\n  \"sellingPrice\": 15,\n  \"quantity\": 4,\n  \"reorderLevel\": 2,\n  \"description\": \"Reusable canvas tote bag.\"\n}"
        },
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Get product by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product is retrieved', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Update product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product is updated', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 9\n}"
        },
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Delete product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product is deleted', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.unset('productId');"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    }
  ]
}
